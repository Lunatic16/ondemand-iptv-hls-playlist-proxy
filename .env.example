# Required: the upstream playlist URL (your curl URL, token included)
UPSTREAM_PLAYLIST_URL=https://ondemand.st/papi/iptv/playlist.m3u?token=CHANGE_ME

# User-Agent sent to the upstream for the playlist, manifests and segments.
# Unquoted, because `docker run --env-file` keeps quotes literally.
# USER_AGENT=Mozilla/5.0 OnDemandIPTV AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.5 Safari/604.1

# Seconds to cache the upstream playlist (stale copy is served if a refresh fails)
# PLAYLIST_TTL=60

# Force the base URL used in rewritten links, e.g. behind a reverse proxy.
# Default: taken from the Host header of the request, so http://<lan-ip>:8080 just works.
# PUBLIC_BASE_URL=http://192.168.1.50:8080

# If set, every request must include ?k=<ACCESS_KEY>; rewritten links carry it automatically.
# Strongly recommended if the port is reachable from outside your LAN.
# ACCESS_KEY=some-long-random-string

# LOG_LEVEL=INFO
